<style>
  input,
  select,
  textarea {
    will-change: transform, border-color;
  }

  .badge-glow {
    animation: pulseGlow 2.5s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.2);
    }
    50% {
      box-shadow: 0 0 8px 2px rgba(34, 197, 94, 0.4);
    }
  }
</style>

<script>
  async function sendContactData(formData: FormData): Promise<{ success: boolean; error?: string }> {
  const URL = 'https://n8n-n8n.tfpyme.easypanel.host/webhook/72856356-078f-4701-a273-55e80fef1107';


  // 🧱 Extraer y mapear los campos del formulario
  const data: Record<string, string> = {};
  formData.forEach((value, key) => {
    data[key] = value.toString();
  });

  try {
    await fetch(URL, {
        method: "POST",
        mode: "no-cors",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

    return { success: true };
  } catch (error: any) {
    return { success: false, error: error?.message || 'Error de red' };
  }
}

  /**
   * INTERFACES ANIMADAS PARA POPUPS (OPEN/CLOSE LOGIC)
   */
  function showModal(modalId: string) {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    modal.classList.remove("hidden");
    setTimeout(() => {
      modal.classList.add("opacity-100");
      const container = modal.firstElementChild;
      if (container) container.classList.replace("scale-95", "scale-100");
    }, 10);
  }

  function hideModal(modal: HTMLElement) {
    modal.classList.remove("opacity-100");
    const container = modal.firstElementChild;
    if (container) container.classList.replace("scale-100", "scale-95");
    setTimeout(() => {
      modal.classList.add("hidden");
    }, 300);
  }

  function initContactUX() {
    console.log(
      "📦 [UX Init] Inicializando listeners del formulario de contacto...",
    );

    const form = document.querySelector(
      "#business-contact-form",
    ) as HTMLFormElement;
    if (!form) return;

    const industrySelect = form.querySelector(
      "#contact-industry",
    ) as HTMLSelectElement;
    const customIndustryWrapper = form.querySelector(
      "#custom-industry-wrapper",
    ) as HTMLDivElement;
    const customIndustryInput = form.querySelector(
      "#contact-custom-industry",
    ) as HTMLInputElement;
    const tzSelect = form.querySelector(
      "#contact-timezone",
    ) as HTMLSelectElement;
    const phoneCountrySelect = form.querySelector(
      "#contact-country-code",
    ) as HTMLSelectElement;

    // --- AUTOMATED TIMEZONE & COUNTRY CODE ---
    if (tzSelect && tzSelect.options.length === 0) {
      const timeZones = (Intl as any).supportedValuesOf?.("timeZone") || [
        "UTC",
        "America/New_York",
        "America/Caracas",
        "Europe/London",
      ];
      const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone;

      timeZones.forEach((tz: string) => {
        const option = document.createElement("option");
        option.value = tz;
        option.textContent = tz.replace(/_/g, " ");
        if (tz === userTz) option.selected = true;
        tzSelect.appendChild(option);
      });

      if (phoneCountrySelect) {
        const tzLower = userTz.toLowerCase();
        let targetCountryId = "US";
        if (tzLower.includes("caracas") || tzLower.includes("venezuela"))
          targetCountryId = "VE";
        else if (
          tzLower.includes("london") ||
          tzLower.includes("europe/london") ||
          tzLower.includes("gb")
        )
          targetCountryId = "UK";
        else if (
          tzLower.includes("sydney") ||
          tzLower.includes("melbourne") ||
          tzLower.includes("australia")
        )
          targetCountryId = "AU";
        else if (tzLower.includes("madrid") || tzLower.includes("spain"))
          targetCountryId = "ES";
        else if (tzLower.includes("mexico")) targetCountryId = "MX";
        else if (tzLower.includes("bogota") || tzLower.includes("colombia"))
          targetCountryId = "CO";
        else if (
          tzLower.includes("buenos_aires") ||
          tzLower.includes("argentina")
        )
          targetCountryId = "AR";
        else if (tzLower.includes("santiago") || tzLower.includes("chile"))
          targetCountryId = "CL";
        else if (tzLower.includes("lima") || tzLower.includes("peru"))
          targetCountryId = "PE";

        const options = Array.from(phoneCountrySelect.options);
        const matchOption = options.find(
          (opt) => opt.getAttribute("data-country-id") === targetCountryId,
        );
        if (matchOption) phoneCountrySelect.value = matchOption.value;
      }
    }

    // --- INTERACTIVE LABELS AND VISIBILITY ---
    function toggleIndustryFields(industryValue: string) {
      if (!customIndustryWrapper || !customIndustryInput) return;

      if (industryValue === "other") {
        customIndustryWrapper.style.setProperty("display", "flex", "important");
        customIndustryInput.required = true;
        setTimeout(() => {
          customIndustryWrapper.classList.remove(
            "scale-95",
            "opacity-0",
            "hidden",
          );
          customIndustryWrapper.classList.add("scale-100", "opacity-100");
        }, 50);
      } else {
        customIndustryInput.required = false;
        customIndustryWrapper.classList.remove("scale-100", "opacity-100");
        customIndustryWrapper.classList.add("scale-95", "opacity-0");
        setTimeout(() => {
          if (industrySelect.value !== "other") {
            customIndustryWrapper.style.display = "none";
            customIndustryWrapper.classList.add("hidden");
          }
        }, 300);
        customIndustryInput.value = "";
      }
    }

    if (industrySelect) {
      toggleIndustryFields(industrySelect.value);
      industrySelect.addEventListener("change", () =>
        toggleIndustryFields(industrySelect.value),
      );
    }

    // --- CLOSE POPUP LISTENERS ---
    const closeButtons = document.querySelectorAll(".close-popup-btn");
    closeButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const parentModal = target.closest('[id^="popup-"]') as HTMLElement;
        if (parentModal) hideModal(parentModal);
      });
    });

    // --- SUBMIT HANDLING WITH MODALS ---
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      const originalBtnText = submitBtn
        ? submitBtn.textContent
        : "Submit Message";

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending Message...";
        submitBtn.classList.add("opacity-70", "cursor-not-allowed");
      }

      const rawFormData = new FormData(form);
      const result = await sendContactData(rawFormData);

      if (result.success) {
        showModal("popup-success");
        form.reset();

        // Reset manual de campos dinámicos
        if (industrySelect) toggleIndustryFields(industrySelect.value);
      } else {
        const errMessageElement = document.getElementById(
          "popup-error-message",
        );
        if (errMessageElement && result.error) {
          errMessageElement.textContent = `Details: ${result.error}`;
        }
        showModal("popup-error");
      }

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
        submitBtn.classList.remove("opacity-70", "cursor-not-allowed");
      }
    });
  }

  // Soporte SPA de Astro (astro:page-load) e inicialización tradicional
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContactUX);
  } else {
    initContactUX();
  }
  document.addEventListener("astro:page-load", initContactUX);

  let hire = document.getElementById("hire");
  hire?.addEventListener("click", () => {
    window.location.href = "/careers#aplication";
  });
</script>
